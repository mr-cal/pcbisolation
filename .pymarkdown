{
  "mode": {
    "strict-config": true
  },
  "extensions": {
    "front-matter": { "enabled": true },
    "markdown-tables": { "enabled": true }
  },
  "plugins": {
    "md013": {
      "enabled": true,
      "line_length": 120,
      "heading_line_length": 250,
      "code_block_line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    "md029": { "enabled": false },
    "md036": { "enabled": false },
    "md041": { "enabled": false }
  }
}
